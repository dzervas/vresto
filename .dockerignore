# Allowlist: credentials and workspace metadata never enter the build context.
**
!Dockerfile
!pyproject.toml
!uv.lock
!NOTICE
!licenses/
!licenses/*LICENSE*
!licenses/*NOTICE*
!src/
!src/kagi_crawler/
!src/kagi_crawler/*.py
# Defense in depth, including files nested in allowlisted directories.
**/.env*
**/.envrc
**/.beads/**
**/.jj/**
**/.git/**
**/__pycache__/**
**/*.pem
**/*.key
**/*credentials*
**/*token*
