# Allowlist: credentials and workspace metadata never enter the build context.
**
!Dockerfile
!pyproject.toml
!MANIFEST.in
!uv.lock
!scripts/
!scripts/install_embedding_model.py
!src/
!src/*.py
!src/sites/
!src/sites/*.py
# Defense in depth, including files nested in allowlisted directories.
**/.env*
**/.envrc
**/.beads/**
**/.jj/**
**/.git/**
**/__pycache__/**
**/*.pem
**/*.key
**/*credentials*
**/*token*
