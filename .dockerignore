# Allowlist: credentials and workspace metadata never enter the build context.
**
!Dockerfile
!pyproject.toml
!uv.lock
!NOTICE
!licenses/
!licenses/embeddinggemma2-Apache-2.0.txt
!scripts/
!scripts/install_embedding_model.py
!src/
!src/kagi_crawler/
!src/kagi_crawler/*.py
!src/kagi_crawler/sites/
!src/kagi_crawler/sites/*.py
# Defense in depth, including files nested in allowlisted directories.
**/.env*
**/.envrc
**/.beads/**
**/.jj/**
**/.git/**
**/__pycache__/**
**/*.pem
**/*.key
**/*credentials*
**/*token*
