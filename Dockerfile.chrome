# Opt-in headed Google Chrome comparison; rebuild the normal base first.
# Stable Chrome is a moving install target. Record browser_check's version and
# retain the built image digest for a reproducible comparison.
ARG BASE_IMAGE=kagi-crawler:latest
FROM ${BASE_IMAGE}
USER root
RUN uv tool run --from patchright==1.63.0 patchright install chrome \
    && command -v Xvfb >/dev/null \
    && mkdir -p /etc/opt/chrome/policies/managed \
    && cp /etc/opt/chrome_for_testing/policies/managed/native-doh.json \
        /etc/opt/chrome/policies/managed/native-doh.json
USER 10001:10001
ENV KAGI_CRAWLER_HEADFUL=1 KAGI_CRAWLER_BROWSER_CHANNEL=chrome
ENTRYPOINT ["python", "-m", "kagi_crawler.headful"]
